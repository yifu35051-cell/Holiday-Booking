# Used by scripts/Start-Backend.ps1 and Docker Compose.
# Copy to .env.mysql once. Keep existing database passwords if a data volume exists.
# Only KEY=value and single-quoted literal values are supported by the launcher.
MYSQL_ROOT_PASSWORD='REPLACE_WITH_YOUR_ROOT_PASSWORD'
MYSQL_PASSWORD='REPLACE_WITH_YOUR_APP_DB_PASSWORD'
MYSQL_PORT=3307

# Host-side Spring Boot port.
SERVER_PORT=8080

# Optional: only used with Start-Backend.ps1 -InitializeAdmin.
# Ordinary startup ignores these values, including on a new database.
# Existing administrator passwords are never reset by initialization.
BOOTSTRAP_ADMIN_EMAIL=''
BOOTSTRAP_ADMIN_PASSWORD=''
