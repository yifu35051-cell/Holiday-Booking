    "com.holidaybooking.backend.identity.ApiSecurityTest#loginRotatesSessionAndCsrfThenLogoutInvalidatesAuthentication": {
      "id": "ID-003",
      "roles": ["Customer"],
      "title": "登录会话轮换、CSRF 更新与退出失效",
      "level": "HTTP/MockMvc",
      "fixture": "先用Service注册UUID邮箱、test-password-123、Session Guest。",
      "input": {
        "login": {
          "email": "$注册邮箱",
          "password": "test-password-123"
        },
        "initialRequest": "GET /api/v1/auth/csrf",
        "headers": {
          "Content-Type": "application/json",
          "X-CSRF-TOKEN": "$匿名token"
        },
        "cookie": "SESSION=$匿名SESSION"
      },
      "steps": [
        "GET csrf取得cookie和token。",
        "POST login携带同一cookie/token和login JSON；保存新cookie。",
        "GET me；用旧token POST logout。",
        "GET csrf取得新token；用新token POST logout；再GET me。"
      ],
      "output": "200 Success<CsrfView/UserView>；403 SecurityError；204空体；401 SecurityError。",
      "checks": [
        "登录200且data.id为注册ID；返回SESSION非空且与匿名会话不同。",
        "me返回200且data.role=CUSTOMER。",
        "旧token退出403；新token退出204；退出后me为401。"
      ],
      "coverageNote": "用例已检查关键状态及会话轮换；未逐字段验证全部响应schema和Cookie安全属性。"
    },
    "com.holidaybooking.backend.identity.ApiSecurityTest#anonymousAndCustomerRequestsCannotReachManagement": {
      "id": "ID-004",
      "roles": ["Guest","Customer"],
      "title": "匿名、降级角色及缺少 CSRF 的访问拒绝",
      "level": "HTTP/MockMvc",
      "fixture": "创建数据库角色CUSTOMER；MockMvc故意给该用户旧ADMIN认证。",
      "input": {
        "requests": [
          {
            "method": "GET",
            "path": "/api/v1/admin/bookings",
            "authentication": null
          },
          {
            "method": "GET",
            "path": "/api/v1/admin/bookings",
            "databaseRole": "CUSTOMER",
            "staleRole": "ADMIN"
          },
          {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "body": {},
            "csrf": null
          }
        ]
      },
      "steps": [
        "依次执行三项请求，第三项不加CSRF。"
      ],
      "output": "SecurityError；HTTP状态依次401、403、403。",
      "checks": [
        "未登录不能读后台。",
        "数据库CUSTOMER不能使用旧ADMIN角色。",
        "缺少CSRF在参数校验前拒绝。"
      ],
      "coverageNote": "只断言状态码；Error字段形状是补充验收，不把{}当成注册字段校验用例。"
    },
