# WireMock payment + verified DirectMail SMTP. No Mailpit runtime dependency.
# Copy to config/deployment.env once. Keep existing database passwords.
APP_VERSION=local-v1
WEB_PORT=8088
MYSQL_ROOT_PASSWORD='REPLACE_WITH_A_RANDOM_ROOT_PASSWORD'
MYSQL_PASSWORD='REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD'

# First empty database only. Existing accounts/passwords are never reset.
# After the first successful startup, both bootstrap values can be left empty.
BOOTSTRAP_ADMIN_EMAIL='admin@example.test'
BOOTSTRAP_ADMIN_PASSWORD='REPLACE_WITH_A_RANDOM_ADMIN_PASSWORD'
DEMO_DATA_ENABLED='false'
EMAIL_DAILY_LIMIT=200
PAYMENT_MODE='wiremock'
WIREMOCK_BASE_URL='http://wiremock:8080'
WIREMOCK_PORT='9090'
WIREMOCK_CALLBACK_SECRET='REPLACE_WITH_64_RANDOM_HEX_CHARACTERS'
TRUSTED_EDGE_SECRET='REPLACE_WITH_ANOTHER_64_RANDOM_HEX_SECRET'
EMAIL_MODE='smtp'
MAIL_HOST='smtpdm.aliyun.com'
MAIL_PORT='465'
MAIL_USERNAME='REPLACE_WITH_VERIFIED_SENDER'
MAIL_PASSWORD='REPLACE_WITH_SMTP_PASSWORD'
MAIL_FROM='REPLACE_WITH_VERIFIED_SENDER'
MAIL_SMTP_AUTH='true'
MAIL_SSL_ENABLE='true'
MAIL_STARTTLS='false'
