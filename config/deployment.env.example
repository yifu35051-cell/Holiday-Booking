# Copy to config/deployment.env once. Keep existing database passwords.
# Used by the Docker production deployment; mock payment and Mailpit remain enabled.
APP_VERSION=local-v1
WEB_PORT=8088
MAILPIT_WEB_PORT=8026
MYSQL_ROOT_PASSWORD='REPLACE_WITH_A_RANDOM_ROOT_PASSWORD'
MYSQL_PASSWORD='REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD'

# First empty database only. Existing accounts/passwords are never reset.
# After the first successful startup, both bootstrap values can be left empty.
BOOTSTRAP_ADMIN_EMAIL='admin@example.test'
BOOTSTRAP_ADMIN_PASSWORD='REPLACE_WITH_A_RANDOM_ADMIN_PASSWORD'
DEMO_DATA_ENABLED=true
EMAIL_DAILY_LIMIT=200
