{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/channel/refund",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.outTradeNo"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "operation": "refund",
      "outTradeNo": "{{jsonPath request.body '$.outTradeNo'}}",
      "decision": "ACCEPTED"
    },
    "transformers": [
      "response-template"
    ]
  }
}
