# WireMock payment + verified DirectMail SMTP. No Mailpit runtime dependency.
# Used by scripts/Start-Backend.ps1 and Docker Compose.
# Copy to config/development.env once. Keep existing passwords if a data volume exists.
# Only KEY=value and single-quoted literal values are supported by the launcher.
MYSQL_ROOT_PASSWORD='REPLACE_WITH_YOUR_ROOT_PASSWORD'
MYSQL_PASSWORD='REPLACE_WITH_YOUR_APP_DB_PASSWORD'
MYSQL_PORT=3307

# Host-side Spring Boot port.
SERVER_PORT=8080

# Optional: only used with Start-Backend.ps1 -InitializeAdmin.
# Ordinary startup ignores these values, including on a new database.
# Existing administrator passwords are never reset by initialization.
BOOTSTRAP_ADMIN_EMAIL=''
BOOTSTRAP_ADMIN_PASSWORD=''

# See docs/支付与邮件部署.md before enabling real external services.
PAYMENT_MODE='wiremock'
EMAIL_MODE='smtp'
JOBS_ENABLED=true
REMINDER_DAYS='1'
API_DOCS_ENABLED=true
SESSION_COOKIE_SECURE=false

# Alipay sandbox only; use single-line PKCS8 private key and Alipay public key.
ALIPAY_APP_ID=''
ALIPAY_PRIVATE_KEY=''
ALIPAY_PUBLIC_KEY=''
ALIPAY_SELLER_ID=''
ALIPAY_NOTIFY_URL=''

# SMTP: use either STARTTLS or implicit SSL according to your provider.
MAIL_HOST='smtpdm.aliyun.com'
MAIL_PORT='465'
MAIL_USERNAME='REPLACE_WITH_VERIFIED_SENDER'
MAIL_PASSWORD='REPLACE_WITH_SMTP_PASSWORD'
MAIL_FROM='REPLACE_WITH_VERIFIED_SENDER'
MAIL_SMTP_AUTH='true'
MAIL_STARTTLS='false'
MAIL_SSL_ENABLE='true'
MAIL_HEALTH_ENABLED=false
MAIL_RECIPIENT_ALLOWLIST=''
EMAIL_DAILY_LIMIT=50

WIREMOCK_BASE_URL='http://127.0.0.1:9090'
WIREMOCK_PORT='9090'
WIREMOCK_CALLBACK_SECRET='REPLACE_WITH_64_RANDOM_HEX_CHARACTERS'
TRUSTED_EDGE_SECRET=''
